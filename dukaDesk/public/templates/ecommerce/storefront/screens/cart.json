      {
        "type": "cart_content",
        "key": "cart-summary",
        "props": {},
        "actions": {
          "checkout": { "type": "go_checkout" },
          "removeItem": { "type": "remove_from_cart" },
          "addItem": { "type": "add_to_cart" }
        }
      }
    ]
  }
}